# Public API URL, hosted on Render
NEXT_PUBLIC_API_URL=https://yuppifacts-api.onrender.com

# Server-side AWS integration. Never expose these values to the browser.
AWS_REGION=us-east-1
AWS_S3_BUCKET=yuppifacts-private-documents
AWS_SES_FROM_EMAIL=notificaciones@your-domain.example
AWS_KMS_KEY_ID=

# API / database values belong in the yuppifacts-api Render service.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
